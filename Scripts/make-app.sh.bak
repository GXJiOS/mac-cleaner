#!/bin/bash
# 把 release 编译产物组装成 MacCleaner.app（输出到 dist/）
set -euo pipefail
cd "$(dirname "$0")/.."

swift build -c release

APP_DIR="dist/MacCleaner.app"
rm -rf "$APP_DIR"
mkdir -p "$APP_DIR/Contents/MacOS" "$APP_DIR/Contents/Resources"
cp .build/release/MacCleaner "$APP_DIR/Contents/MacOS/MacCleaner"

cat > "$APP_DIR/Contents/Info.plist" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>MacCleaner</string>
	<key>CFBundleIdentifier</key>
	<string>com.gcdm.maccleaner</string>
	<key>CFBundleName</key>
	<string>MacCleaner</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>NSHighResolutionCapable</key>
	<true/>
</dict>
</plist>
EOF

# ad-hoc 签名，保证授予"完全磁盘访问"后 TCC 记录稳定
codesign --force --sign - "$APP_DIR"

echo "已生成 $(pwd)/$APP_DIR"
echo "可直接双击运行，或拖到 /Applications 后在「系统设置 → 隐私与安全性 → 完全磁盘访问」中授权以扫描受保护目录"
